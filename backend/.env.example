APP_ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/dev.db
OPENAI_API_KEY=replace-me
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
BRIDGE_TOKEN=replace-me-long-random-string
ADMIN_API_KEY=replace-me-long-random-string
BUSINESS_NAME=Sparkle Car Wash
AGENT_NAME=Asha
DEFAULT_LANGUAGE=en-IN
RECORDINGS_DIR=./data/recordings
RECORDING_RETENTION_DAYS=90
MAX_CALL_SECONDS=900
ENABLE_LOCAL_BRIDGE=true
PORT=8000

# Plivo (phone provider). Leave empty to disable the phone endpoints.
PUBLIC_BASE_URL=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_WS_SECRET=
PLIVO_NUMBER=
