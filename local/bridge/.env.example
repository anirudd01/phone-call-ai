BACKEND_WS_URL=ws://localhost:8000/ws/local-bridge
BACKEND_HTTP_URL=http://localhost:8000
# Must equal BRIDGE_TOKEN in backend/.env
BRIDGE_TOKEN=replace-me-long-random-string
BRIDGE_ID=laptop
# laptop = default microphone and speakers (use a headset); bluetooth = named devices below
AUDIO_MODE=laptop
# Only needed to pick specific devices (part of the name; run: carwash-bridge devices)
IN_DEVICE=
OUT_DEVICE=
